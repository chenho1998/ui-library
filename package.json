{
  "name": "ui-library",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @yourorg/tokens build && pnpm --filter @yourorg/icons build && pnpm --filter @yourorg/ui build",
    "test": "pnpm --filter @yourorg/ui test",
    "typecheck": "pnpm --filter @yourorg/icons typecheck && pnpm --filter @yourorg/ui typecheck",
    "lint": "eslint . && stylelint \"packages/**/*.css\"",
    "storybook": "pnpm --filter @yourorg/storybook dev",
    "build-storybook": "pnpm --filter @yourorg/storybook build",
    "test:visual": "pnpm --filter @yourorg/storybook test:visual",
    "test:visual:update": "pnpm --filter @yourorg/storybook test:visual:update",
    "changeset": "changeset",
    "size": "pnpm --filter @yourorg/ui size"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
