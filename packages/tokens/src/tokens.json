{
  "$description": "Source of truth for @yourorg/tokens (DTCG-style). Palettes are generated from these base colours in OKLCH.",
  "palette": {
    "brand":   { "$type": "color", "$value": "#3366ff" },
    "neutral": { "$type": "color", "$value": "#64748b", "$extensions": { "chroma": 0.014 } },
    "red":     { "$type": "color", "$value": "#dc2626" },
    "amber":   { "$type": "color", "$value": "#e0a100" },
    "green":   { "$type": "color", "$value": "#16a34a" },
    "blue":    { "$type": "color", "$value": "#2563eb" }
  },
  "semantic": {
    "light": {
      "bg": "#ffffff",
      "surface": "#ffffff",
      "surface-subtle": "{neutral.50}",
      "surface-muted": "{neutral.100}",
      "text-primary": "{neutral.900}",
      "text-secondary": "{neutral.600}",
      "text-disabled": "{neutral.400}",
      "text-on-accent": "#ffffff",
      "border": "{neutral.200}",
      "border-strong": "{neutral.500}",
      "accent": "{brand.600}",
      "accent-hover": "{brand.700}",
      "accent-active": "{brand.800}",
      "accent-subtle": "{brand.50}",
      "accent-text": "{brand.700}",
      "focus-ring": "{brand.500}",
      "success": "{green.600}",
      "success-subtle": "{green.50}",
      "success-text": "{green.800}",
      "warning": "{amber.600}",
      "warning-subtle": "{amber.50}",
      "warning-text": "{amber.800}",
      "danger": "{red.600}",
      "danger-hover": "{red.700}",
      "danger-subtle": "{red.50}",
      "danger-text": "{red.700}",
      "info": "{blue.600}",
      "info-subtle": "{blue.50}",
      "info-text": "{blue.800}",
      "overlay": "rgb(15 23 42 / 0.45)"
    },
    "dark": {
      "bg": "{neutral.950}",
      "surface": "{neutral.900}",
      "surface-subtle": "{neutral.800}",
      "surface-muted": "{neutral.800}",
      "text-primary": "{neutral.50}",
      "text-secondary": "{neutral.300}",
      "text-disabled": "{neutral.500}",
      "text-on-accent": "{neutral.950}",
      "border": "{neutral.700}",
      "border-strong": "{neutral.500}",
      "accent": "{brand.400}",
      "accent-hover": "{brand.300}",
      "accent-active": "{brand.200}",
      "accent-subtle": "{brand.900}",
      "accent-text": "{brand.300}",
      "focus-ring": "{brand.400}",
      "success": "{green.400}",
      "success-subtle": "{green.900}",
      "success-text": "{green.200}",
      "warning": "{amber.400}",
      "warning-subtle": "{amber.900}",
      "warning-text": "{amber.200}",
      "danger": "{red.400}",
      "danger-hover": "{red.300}",
      "danger-subtle": "{red.900}",
      "danger-text": "{red.200}",
      "info": "{blue.400}",
      "info-subtle": "{blue.900}",
      "info-text": "{blue.200}",
      "overlay": "rgb(0 0 0 / 0.6)"
    }
  },
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "xs": ["12px", "16px"], "sm": ["14px", "20px"], "md": ["16px", "24px"], "lg": ["18px", "28px"],
      "xl": ["20px", "28px"], "2xl": ["24px", "32px"], "3xl": ["30px", "36px"], "4xl": ["36px", "44px"]
    }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "control": { "sm": "32px", "md": "40px", "lg": "48px" },
  "icon": { "sm": "16px", "md": "20px", "lg": "24px" },
  "radius": { "none": "0", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
  "border": { "thin": "1px", "thick": "2px" },
  "shadow": {
    "sm": "0 1px 2px rgb(15 23 42 / 0.06), 0 1px 3px rgb(15 23 42 / 0.1)",
    "md": "0 4px 6px -1px rgb(15 23 42 / 0.1), 0 2px 4px -2px rgb(15 23 42 / 0.1)",
    "lg": "0 10px 15px -3px rgb(15 23 42 / 0.12), 0 4px 6px -4px rgb(15 23 42 / 0.1)",
    "xl": "0 20px 25px -5px rgb(15 23 42 / 0.15), 0 8px 10px -6px rgb(15 23 42 / 0.1)"
  },
  "duration": { "fast": "100ms", "normal": "200ms", "slow": "300ms" },
  "easing": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0, 0, 0, 1)",
    "exit": "cubic-bezier(0.3, 0, 1, 1)"
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" },
  "z": { "dropdown": 1000, "sticky": 1100, "overlay": 1300, "modal": 1400, "popover": 1500, "toast": 1600, "tooltip": 1700 }
}
