{
  "name": "@yourorg/icons",
  "version": "0.1.0",
  "description": "Tree-shakeable SVG icons and createIcon helper for @yourorg/ui",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
